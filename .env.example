# jevai-products — copy to .env and fill. NEVER commit .env.

# TypeSafe / Jev API key (https://console.typesafe.ai). Required for live judgments.
TYPESAFE_API_KEY=

# Default model. jev-latest → current jev-1.13.0
JEV_MODEL=jev-latest

# Engine HTTP port
PORT=8080

# Free-trial token allowance before the payment gate trips (set 0 to gate immediately)
JEVAI_TRIAL_TOKENS=1000000

# SQLite ledger path
JEVAI_DB=jevai.db
