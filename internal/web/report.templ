package web

import "jevai/internal/judge"

// ItemReport renders a single-item screening result (claims, ad pre-flight…).
// label names the Context value (e.g. "category" or "platform").
templ ItemReport(rep *judge.ItemReport, label string) {
	@Panel("result · screening") {
		if rep.Context != "" {
			<div class="mb-4 font-mono text-xs text-muted">{ label }: { rep.Context }</div>
		}
		<ul class="grid gap-2.5">
			for _, f := range rep.Findings {
				<li class="flex items-center justify-between gap-4 border-b border-line pb-2.5 font-mono text-xs last:border-0">
					<span class="flex items-center gap-2.5">
						<span class={ "dot", tierBg(probTier(f.Prob)) }></span>
						<span class={ flagText(f.Flag) }>{ f.Label }</span>
					</span>
					<span class={ riskClass(f.Prob) }>{ pct(f.Prob) }</span>
				</li>
			}
		</ul>
		<p class="label mt-4">
			{ itemMeta(rep) }
			if rep.Sample {
				<span class="text-flag"> · SAMPLE — set TYPESAFE_API_KEY for live</span>
			}
		</p>
	}
}
