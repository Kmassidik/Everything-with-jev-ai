package web

import "jevai/internal/account"
import "jevai/internal/judge"

templ Ads(user *account.User, sample []judge.Item) {
	@Layout("javai — ad pre-flight") {
		@Nav(user)
		<main class="grid-bg">
			<div class="wrap py-16">
				<div class="max-w-3xl">
					<div class="flex items-center gap-3">
						@iconBadge("ad")
						<span class="label">Surface · ad pre-flight</span>
					</div>
					<h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">Pre-flight the whole campaign.</h1>
					<p class="mt-4 max-w-xl text-muted">
						Upload your ad variants before you spend. Every creative is screened for prohibited
						claims, brand safety, restricted categories, misleading urgency — and whether it
						matches the landing page. Ranked worst-first, with a CSV to hand the client.
					</p>
					@whyUse(
						"A rejected ad isn't just a rejection — it's spend that never ran, a launch that slipped, and enough strikes to get the whole ad account disabled.",
						[]string{
							"Know which variants Meta/TikTok/Google will bounce before you submit, not after.",
							"Catch creative that promises what the landing page doesn't deliver — the top reason ads get pulled mid-flight.",
							"Hand the client a clean pre-flight report instead of an apology.",
						},
					)
					@inOut("An ad creative + its landing page", "a rejection-risk score + why it'll get pulled", "e.g. “Lose 10kg in a week — guaranteed!” → 88% · misleading-claim, health-restricted")
					@sampleTable(sample)
					@uploadForm("/ads/audit", "/ads/sample", "/ads/sample.csv", "creative · landing · platform · max 200 variants")
					<div id="report" class="mt-10"></div>
				</div>
			</div>
		</main>
		@Foot()
	}
}
