package web

// productIcon renders a per-surface line icon so users grasp each product at a glance.
templ productIcon(name string) {
	switch name {
		case "listing":
			<!-- checklist -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
				<path d="M10 6h10M10 12h10M10 18h10"/>
				<path d="M3 6l1.4 1.4L6.2 4.6"/>
				<path d="M3 12l1.4 1.4L6.2 10.6"/>
				<path d="M3 18l1.4 1.4L6.2 16.6"/>
			</svg>
		case "ad":
			<!-- megaphone -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
				<path d="M3 11v2a1 1 0 0 0 1 1h2l9 4V6L6 10H4a1 1 0 0 0-1 1Z"/>
				<path d="M18 8a4 4 0 0 1 0 8"/>
				<path d="M7 15v3a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2"/>
			</svg>
		case "claim":
			<!-- shield check -->
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
				<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/>
				<path d="M9 12l2 2 4-4"/>
			</svg>
		default:
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-6 w-6"><circle cx="12" cy="12" r="8"/></svg>
	}
}

// iconBadge is the icon in a lime tile, used on cards and page headers.
templ iconBadge(name string) {
	<span class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-ink bg-lime/25 text-ink">
		@productIcon(name)
	</span>
}
