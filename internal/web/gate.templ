package web

import "jevai/internal/billing"

// GateBlocked is shown when a caller has spent their free trial.
templ GateBlocked(st billing.Status) {
	@Panel("trial spent") {
		<div class="font-display text-2xl font-bold text-flag">Trial spent</div>
		<p class="mt-2 text-sm text-muted">{ gateUsage(st) }</p>
		<p class="mt-1 text-sm text-muted">Upgrade to keep judging every item.</p>
		<a href="#get" class="btn-brand mt-4 w-fit">Upgrade →</a>
	}
}
