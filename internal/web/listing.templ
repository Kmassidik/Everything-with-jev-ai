package web

import "jevai/internal/account"
import "jevai/internal/judge"
import "fmt"
import "time"

templ Listing(user *account.User, sample []judge.Item) {
	@Layout("javai — listing hygiene") {
		@Nav(user)
		<main class="grid-bg">
			<div class="wrap py-16">
				<div class="max-w-3xl">
					<div class="flex items-center gap-3">
						@iconBadge("listing")
						<span class="label">Surface · listing hygiene</span>
					</div>
					<h1 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">Audit every listing.</h1>
					<p class="mt-4 max-w-xl text-muted">
						Upload a CSV of your listings. Every row is scored on title–description match,
						category, prohibited claims and missing detail — ranked worst-first, with a CSV of
						the fixes to hand back.
					</p>
					@whyUse(
						"A bad listing doesn't warn you — the marketplace just buries it, or suspends the account. You find out when sales stop.",
						[]string{
							"Catch the prohibited claim or banned word before Shopee/Tokopedia/Amazon pulls the listing.",
							"Fix title–category mismatches that quietly kill your search ranking.",
							"Run it on all 10,000 rows for the price of a coffee — not a spot-check of 20.",
						},
					)
					@inOut("A row of your catalogue", "a risk score + the flags that fire", "e.g. “MIRACLE CURE PILLS, cures everything” → 91% · prohibited-claim, category-mismatch")
					@sampleTable(sample)
					@uploadForm("/listing/audit", "/listing/sample", "/listing/sample.csv", "sku · title · description · category · price · max 200 rows")
					<div id="report" class="mt-10"></div>
				</div>
			</div>
		</main>
		@Foot()
	}
}

// whyUse tells the short "why should I bother" story: the stakes, then the concrete
// things this product stops from happening.
templ whyUse(stakes string, pts []string) {
	<div class="mt-10 rounded-2xl border border-ink bg-surface p-6">
		<span class="label">Why run it</span>
		<p class="mt-3 max-w-2xl text-lg font-medium leading-snug">{ stakes }</p>
		<ul class="mt-5 grid gap-3">
			for _, p := range pts {
				<li class="flex items-start gap-3">
					<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-flag"></span>
					<span class="text-muted">{ p }</span>
				</li>
			}
		</ul>
	</div>
}

// sampleTable shows the actual input rows so users can see the data before scoring it.
templ sampleTable(items []judge.Item) {
	if len(items) > 0 {
		<div class="mt-10">
			<p class="label mb-2">Sample input · { fmt.Sprintf("%d rows", len(items)) } — this is what one click will score</p>
			<div class="card overflow-x-auto">
				<table class="w-full border-collapse font-mono text-xs">
					<thead>
						<tr class="label border-b border-line text-left">
							for _, c := range items[0].Cols {
								<th class="px-3 py-2">{ c.Key }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, it := range items {
							<tr class="border-b border-line align-top last:border-0">
								for _, c := range it.Cols {
									<td class="px-3 py-2"><div class="max-w-[24ch] truncate">{ c.Val }</div></td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}

// inOut is the plain-English "what goes in → what comes out" framing on each product page.
templ inOut(in, out, example string) {
	<div class="card mt-6 p-5">
		<div class="flex flex-wrap items-center gap-2 font-mono text-sm">
			<span class="chip">in</span>
			<span>{ in }</span>
			<span class="text-lime">→</span>
			<span class="chip border-lime bg-lime/20">out</span>
			<span class="font-semibold">{ out }</span>
		</div>
		<p class="label mt-3">{ example }</p>
	</div>
}

templ uploadForm(action, sampleAction, sampleCSV, cols string) {
	<div class="mt-8">
		<div class="flex flex-wrap items-center gap-3">
			<button
				type="button"
				class="btn-brand w-fit"
				hx-post={ sampleAction }
				hx-target="#report"
				hx-swap="innerHTML"
				hx-indicator="#spin"
			>Run the sample ▸</button>
			<span class="label">see it work in one click — no file needed</span>
			<span id="spin" class="htmx-indicator label">scoring…</span>
		</div>
		<form
			class="mt-6 grid gap-3"
			hx-post={ action }
			hx-target="#report"
			hx-swap="innerHTML"
			hx-encoding="multipart/form-data"
			hx-indicator="#spin"
		>
			<label class="label">…or run your own CSV</label>
			<input type="file" name="csv" accept=".csv,text/csv" required class="field"/>
			<div class="flex flex-wrap items-center gap-3">
				<button type="submit" class="btn-ghost w-fit">Run on my CSV →</button>
				<a href={ templ.SafeURL(sampleCSV) } class="label underline underline-offset-2">download sample CSV</a>
			</div>
			<p class="label">columns: { cols }</p>
		</form>
	</div>
}

templ ErrorBox(msg string) {
	@Panel("error") {
		<p class="font-mono text-xs text-flag">{ msg }</p>
	}
}

// BatchReport is the HTMX fragment after an audit (listing or ads): table + actions.
templ BatchReport(rep *judge.Report, id string) {
	@Panel("result · " + rep.Pack) {
		@batchRows(rep)
		<p class="label mt-4">
			{ reportMeta(rep) }
			if rep.Sample {
				<span class="text-flag"> · SAMPLE — set TYPESAFE_API_KEY for live</span>
			}
		</p>
		if id != "" {
			<div class="mt-5 flex flex-wrap items-center gap-3 border-t border-line pt-5">
				<a href={ templ.SafeURL("/a/" + id + "/csv") } class="btn-brand">Download CSV →</a>
				<a href={ templ.SafeURL("/a/" + id) } class="btn-ghost">Permalink</a>
				<span class="label">saved · share the link</span>
			</div>
		}
	}
}

// AuditPage is the permalink for a saved audit (listing or ads).
templ AuditPage(user *account.User, rep *judge.Report, id string, at time.Time) {
	@Layout("javai — saved audit") {
		@Nav(user)
		<main class="grid-bg">
			<div class="wrap py-16">
				<div class="max-w-3xl">
					<span class="label">Saved · { at.UTC().Format("2 Jan 2006, 15:04 MST") }</span>
					<h1 class="mt-3 font-display text-4xl font-bold tracking-tight">{ packTitle(rep.Pack) }</h1>
					<div class="mt-6 flex flex-wrap gap-3">
						<a href={ templ.SafeURL("/a/" + id + "/csv") } class="btn-brand">Download CSV →</a>
						<a href="/listing" class="btn-ghost">New audit</a>
					</div>
					<div class="mt-8">
						@Panel("result · " + rep.Pack) {
							@batchRows(rep)
							<p class="label mt-4">{ reportMeta(rep) }</p>
						}
					</div>
				</div>
			</div>
		</main>
		@Foot()
	}
}

templ AuditNotFound() {
	@Layout("javai — not found") {
		@Nav(nil)
		<main class="grid-bg">
			<div class="wrap py-24 text-center">
				<h1 class="font-display text-4xl font-bold tracking-tight">Audit not found</h1>
				<p class="mt-3 text-muted">That link has expired or never existed.</p>
				<a href="/listing" class="btn-brand mt-6">Run a new audit →</a>
			</div>
		</main>
		@Foot()
	}
}

templ batchRows(rep *judge.Report) {
	<div class="overflow-x-auto">
		<table class="w-full border-collapse font-mono text-xs">
			<thead>
				<tr class="label border-b border-line text-left">
					<th class="py-1.5 pr-3">#</th>
					<th class="py-1.5 pr-3">Item</th>
					<th class="py-1.5 pr-3">Risk</th>
					<th class="py-1.5">Flags</th>
				</tr>
			</thead>
			<tbody>
				for _, res := range rep.Results {
					<tr class="border-b border-line align-top last:border-0">
						<td class="py-2 pr-3 text-muted">{ fmt.Sprint(res.Item.Row) }</td>
						<td class="max-w-[26ch] truncate py-2 pr-3">{ itemTitle(res) }</td>
						<td class="py-2 pr-3">
							if res.Err != "" {
								<span class="text-muted">—</span>
							} else {
								<span class="inline-flex items-center gap-1.5">
									<span class={ "dot", tierBg(probTier(res.Risk)) }></span>
									<span class={ riskClass(res.Risk) }>{ pct(res.Risk) }</span>
								</span>
							}
						</td>
						<td class="py-2">
							if res.Err != "" {
								<span class="text-flag">error</span>
							} else {
								for _, f := range res.Findings {
									if f.Flag {
										<span class="chip mb-1 mr-1 border-flag/40 text-flag">{ f.Label }</span>
									}
								}
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
