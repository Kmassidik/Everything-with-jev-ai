package web

import "jevai/internal/judge"
import "fmt"

templ Listing() {
	@Layout("javai — listing hygiene") {
		@Nav()
		<main class="grid-bg">
			<div class="wrap py-16">
				<div class="max-w-3xl">
					<span class="label">Surface · listing hygiene</span>
					<h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Audit every listing.</h1>
					<p class="mt-4 max-w-xl text-muted">
						Upload a CSV of your listings. Every row is judged on title–description match,
						category, prohibited claims and missing detail — then ranked worst-first.
					</p>
					<form
						class="mt-8 grid gap-3"
						hx-post="/listing/audit"
						hx-target="#report"
						hx-swap="innerHTML"
						hx-encoding="multipart/form-data"
						hx-indicator="#spin"
					>
						<input type="file" name="csv" accept=".csv,text/csv" required class="field"/>
						<div class="flex items-center gap-3">
							<button type="submit" class="btn-brand w-fit">Run audit →</button>
							<span id="spin" class="htmx-indicator label">judging…</span>
						</div>
						<p class="label">columns: sku · title · description · category · price · max 200 rows</p>
					</form>
					<div id="report" class="mt-10"></div>
				</div>
			</div>
		</main>
		@Foot()
	}
}

templ ErrorBox(msg string) {
	@Panel("error") {
		<p class="font-mono text-xs text-flag">{ msg }</p>
	}
}

templ ListingReport(rep *judge.Report) {
	@Panel("result · listing-hygiene") {
		<div class="overflow-x-auto">
			<table class="w-full border-collapse font-mono text-xs">
				<thead>
					<tr class="label border-b border-line text-left">
						<th class="py-1.5 pr-3">#</th>
						<th class="py-1.5 pr-3">Listing</th>
						<th class="py-1.5 pr-3">Risk</th>
						<th class="py-1.5">Flags</th>
					</tr>
				</thead>
				<tbody>
					for _, res := range rep.Results {
						<tr class="border-b border-line align-top last:border-0">
							<td class="py-2 pr-3 text-muted">{ fmt.Sprint(res.Listing.Row) }</td>
							<td class="max-w-[24ch] truncate py-2 pr-3">{ listingTitle(res) }</td>
							<td class="py-2 pr-3">
								if res.Err != "" {
									<span class="text-muted">—</span>
								} else {
									<span class="inline-flex items-center gap-1.5">
										<span class={ "dot", tierBg(probTier(res.Risk)) }></span>
										<span class={ riskClass(res.Risk) }>{ pct(res.Risk) }</span>
									</span>
								}
							</td>
							<td class="py-2">
								if res.Err != "" {
									<span class="text-flag">error</span>
								} else {
									for _, f := range res.Findings {
										if f.Flag {
											<span class="chip mb-1 mr-1 border-flag/40 text-flag">{ f.Label }</span>
										}
									}
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="label mt-4">
			{ reportMeta(rep) }
			if rep.Sample {
				<span class="text-flag"> · SAMPLE — set TYPESAFE_API_KEY for live</span>
			}
		</p>
	}
}
