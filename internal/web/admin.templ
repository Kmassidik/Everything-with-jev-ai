package web

import "jevai/internal/account"

templ Admin(token string, invites []account.Invite) {
	@Layout("javai — admin") {
		@Nav(nil)
		<main class="grid-bg">
			<div class="wrap py-16">
				<div class="max-w-2xl">
					<span class="label">Admin · invites</span>
					<h1 class="mt-3 font-display text-4xl font-bold tracking-tight">Invite people.</h1>
					<p class="mt-4 text-muted">Generate a one-time link and send it. It creates one account, then stops working.</p>
					<form method="post" action={ templ.SafeURL("/admin/invite?token=" + token) } class="mt-8 flex flex-wrap gap-3">
						<input name="note" placeholder="note — who's this for?" class="field max-w-xs"/>
						<button type="submit" class="btn-brand w-fit">New invite link →</button>
					</form>
					if len(invites) > 0 {
						<div class="card mt-8 divide-y divide-line">
							for _, iv := range invites {
								<div class="flex items-center justify-between gap-4 px-4 py-3 font-mono text-xs">
									<span class="min-w-0 truncate">
										if iv.Used {
											<span class="text-muted">used · /join/{ iv.Token }</span>
										} else {
											<span class="text-safe">open</span> · /join/{ iv.Token }
										}
									</span>
									<span class="label shrink-0">{ iv.Note }</span>
								</div>
							}
						</div>
						<p class="label mt-4">Prepend your domain: https://jevai.glicc.id/join/&lt;token&gt;</p>
					}
				</div>
			</div>
		</main>
		@Foot()
	}
}
