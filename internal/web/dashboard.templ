package web

import "jevai/internal/account"

script copyText(s string) {
	navigator.clipboard.writeText(s);
}

templ Dashboard(d DashData) {
	@Layout("javai — dashboard") {
		@Nav(d.User)
		<main class="grid-bg">
			<div class="wrap py-16">
				<span class="label">Dashboard</span>
				<h1 class="mt-3 font-display text-4xl font-bold tracking-tight sm:text-5xl">Hi, { d.User.DisplayName }.</h1>
				<div class="mt-6 flex flex-wrap items-center gap-3">
					<span class="chip">{ usageChip(d.Usage, d.Gate) }</span>
					if d.Gate.Blocked {
						<span class="chip border-flag/40 text-flag">trial spent</span>
					}
					if d.IsAdmin {
						<span class="chip border-lime bg-lime/20">admin</span>
					}
					<a href="/profile" class="chip transition hover:border-ink">Profile →</a>
				</div>
				<h2 class="label mt-14">Run a product</h2>
				<div class="mt-4 grid gap-4 sm:grid-cols-3">
					@surfaceCard("listing", "Listing hygiene", "messy catalogue → ranked fix list", "/listing")
					@surfaceCard("ad", "Ad pre-flight", "variants → what'll get rejected", "/ads")
					@surfaceCard("claim", "Claim screening", "copy → the claims that'll bite you", "/claims")
				</div>
				if d.IsAdmin {
					@invitePanel(d)
				}
				<h2 class="label mt-14">Your recent audits</h2>
				if len(d.Recent) == 0 {
					<p class="mt-4 text-muted">Nothing yet — run a product above and it saves here.</p>
				} else {
					<div class="card mt-4 divide-y divide-line">
						for _, a := range d.Recent {
							<a href={ templ.SafeURL("/a/" + a.ID) } class="flex items-center justify-between gap-4 px-4 py-3 transition hover:bg-paper">
								<span class="font-mono text-sm">{ packTitle(a.Pack) }</span>
								<span class="label">{ auditMetaLine(a) }</span>
							</a>
						}
					</div>
				}
			</div>
		</main>
		@Foot()
	}
}

templ invitePanel(d DashData) {
	<h2 class="label mt-14">Invites <span class="text-muted">· admin · one link = one account</span></h2>
	<form method="post" action="/invites/new" class="mt-4 flex flex-wrap gap-3">
		<input name="note" placeholder="note — who's this for?" class="field max-w-xs"/>
		<button type="submit" class="btn-brand w-fit">New invite link →</button>
	</form>
	if len(d.Invites) > 0 {
		<div class="card mt-4 divide-y divide-line">
			for _, iv := range d.Invites {
				<div class="flex items-center gap-3 px-4 py-3 font-mono text-xs">
					if iv.Used {
						<span class="min-w-0 flex-1 truncate text-muted">used · { d.BaseURL }/join/{ iv.Token }</span>
						if iv.Note != "" {
							<span class="label shrink-0">{ iv.Note }</span>
						}
					} else {
						<span class="min-w-0 flex-1 truncate">{ d.BaseURL }/join/{ iv.Token }</span>
						<button type="button" class="chip shrink-0 transition hover:border-ink" onclick={ copyText(d.BaseURL + "/join/" + iv.Token) }>copy</button>
						<form method="post" action="/invites/revoke" class="shrink-0">
							<input type="hidden" name="token" value={ iv.Token }/>
							<button type="submit" class="chip text-flag transition hover:border-flag">revoke</button>
						</form>
					}
				</div>
			}
		</div>
	}
}

templ Profile(user *account.User, msg string) {
	@Layout("javai — profile") {
		@Nav(user)
		<main class="grid-bg">
			<div class="wrap py-16">
				<div class="max-w-md">
					<span class="label">Profile</span>
					<h1 class="mt-3 font-display text-4xl font-bold tracking-tight">{ user.Username }</h1>
					if msg != "" {
						<p class="mt-4 font-mono text-xs text-ink">{ msg }</p>
					}
					<form method="post" action="/profile/name" class="mt-8 grid gap-2">
						<label class="label">Display name</label>
						<input name="display_name" value={ user.DisplayName } class="field"/>
						<button type="submit" class="btn-ghost mt-1 w-fit">Save name</button>
					</form>
					<form method="post" action="/profile/password" class="mt-10 grid gap-2">
						<label class="label">Change password</label>
						<input name="password" type="password" placeholder="new password (8+ characters)" class="field"/>
						<button type="submit" class="btn-ghost mt-1 w-fit">Change password</button>
					</form>
				</div>
			</div>
		</main>
		@Foot()
	}
}
