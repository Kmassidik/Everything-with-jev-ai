package web

import "jevai/internal/account"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link
				href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
				rel="stylesheet"
			/>
			<link rel="stylesheet" href={ "/static/css/app.css?v=" + CSSVersion }/>
			<script src="/static/js/htmx.min.js" defer></script>
		</head>
		<body class="min-h-full bg-paper font-sans text-ink">
			{ children... }
		</body>
	</html>
}

templ Nav(user *account.User) {
	<header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur">
		<div class="wrap flex items-center gap-6 py-3">
			<a href="/" class="flex items-center gap-1.5 font-display text-lg font-bold tracking-tight">javai<span class="inline-block h-2.5 w-2.5 bg-lime"></span></a>
			<nav class="ml-auto flex items-center gap-5 text-sm">
				<a href="/#surfaces" class="text-muted transition hover:text-ink">Products</a>
				<a href="/#how" class="text-muted transition hover:text-ink">How</a>
				if user != nil {
					<a href="/app" class="text-muted transition hover:text-ink">Dashboard</a>
					<form method="post" action="/logout"><button type="submit" class="btn-ghost">Log out</button></form>
				} else {
					<a href="/login" class="btn-brand">Log in</a>
				}
			</nav>
		</div>
	</header>
}

templ Foot() {
	<footer class="border-t border-line">
		<div class="wrap flex flex-wrap items-center gap-4 py-8 text-sm text-muted">
			<span class="flex items-center gap-1.5 font-display font-bold text-ink">javai<span class="inline-block h-2 w-2 bg-lime"></span></span>
			<span>score every item, sort what matters</span>
			<span class="ml-auto font-mono text-xs">© 2026 · model by <span class="text-ink">TypeSafe</span> · Jev</span>
		</div>
	</footer>
}

// Panel is a clean titled card used by the report/result fragments.
templ Panel(title string) {
	<div class="card overflow-hidden">
		<div class="flex items-center gap-2 border-b border-line bg-paper px-4 py-2.5">
			<span class="inline-block h-2 w-2 bg-lime"></span>
			<span class="label">{ title }</span>
		</div>
		<div class="p-5">
			{ children... }
		</div>
	</div>
}
